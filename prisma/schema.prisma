model Installment {
  id             String            @id @default(cuid())
  companyId      String
  receivableId   String
  patientId      String
  sequence       Int
  dueDate        DateTime
  amount         Decimal           @db.Decimal(12, 2)
  receivedAmount Decimal           @default(0) @db.Decimal(12, 2)
  balance        Decimal           @db.Decimal(12, 2)
  status         InstallmentStatus @default(PENDING)
  canceledAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@unique([receivableId, sequence])
  @@index([companyId, dueDate, status, deletedAt])
  @@index([companyId, receivableId, deletedAt])
  @@index([patientId, dueDate])
}

model Payment {
  id             String        @id @default(cuid())
