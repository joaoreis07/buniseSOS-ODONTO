}

model Receivable {
  id             String           @id @default(cuid())
  companyId      String
  patientId      String
  budgetId       String?          @unique
  code           String
  title          String
  notes          String?          @db.Text
  status         ReceivableStatus @default(OPEN)
  subtotal       Decimal          @db.Decimal(12, 2)
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  total          Decimal          @db.Decimal(12, 2)
  receivedAmount Decimal          @default(0) @db.Decimal(12, 2)
  balance        Decimal          @db.Decimal(12, 2)
  createdById    String?
  updatedById    String?
  canceledAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  budget       TreatmentBudget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("ReceivableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?            @relation("ReceivableUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items        ReceivableItem[]
  installments Installment[]
  events       FinanceEvent[]

  @@unique([companyId, code])
  @@index([companyId, patientId, deletedAt])
  @@index([companyId, status, deletedAt])
  @@index([companyId, createdAt])
}

model ReceivableItem {
  id             String   @id @default(cuid())
  companyId      String
  receivableId   String
  budgetItemId   String?
  description    String
  code           String?
  professionalId String?
  quantity       Decimal  @db.Decimal(10, 2)
  unitPrice      Decimal  @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  receivable   Receivable            @relation(fields: [receivableId], references: [id], onDelete: Cascade)
