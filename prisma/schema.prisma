enum ClinicalAttachmentType {
  DOCUMENT
  EXAM
  OTHER
}

enum ClinicalEvolutionEventType {
  CREATED
  UPDATED
  DELETED
}

model PatientAnamnesis {
  id                   String   @id @default(cuid())
  companyId            String
  patientId            String   @unique
  allergies            String?  @db.Text
  medications          String?  @db.Text
  diseases             String?  @db.Text
  surgeries            String?  @db.Text
  medicalHistory       String?  @db.Text
  dentalHistory        String?  @db.Text
  observations         String?  @db.Text
  smoking              String?
  alcoholUse           String?
  oralHygiene          String?
  parafunctionalHabits String?  @db.Text
  otherHabits          String?  @db.Text
  createdById          String?
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient   Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?               @relation("AnamnesisCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?               @relation("AnamnesisUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  revisions AnamnesisRevision[]

  @@unique([companyId, patientId])
  @@index([companyId])
}

model AnamnesisRevision {
  id          String   @id @default(cuid())
  companyId   String
  anamnesisId String
  actorId     String?
  snapshot    Json
  createdAt   DateTime @default(now())

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  anamnesis PatientAnamnesis @relation(fields: [anamnesisId], references: [id], onDelete: Cascade)
  actor     User?            @relation("AnamnesisRevisionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, anamnesisId, createdAt])
}

model ClinicalEvolution {
  id                  String    @id @default(cuid())
  companyId           String
  patientId           String
  professionalId      String?
  appointmentId       String?
  treatmentPlanItemId String?
  procedureId         String?
  title               String
  description         String    @db.Text
  notes               String?   @db.Text
  occurredAt          DateTime  @default(now())
  createdById         String?
  updatedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient           Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional      Professional?            @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  appointment       Appointment?             @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  treatmentPlanItem TreatmentPlanItem?       @relation(fields: [treatmentPlanItemId], references: [id], onDelete: SetNull)
  procedure         ProcedureCatalog?        @relation(fields: [procedureId], references: [id], onDelete: SetNull)
