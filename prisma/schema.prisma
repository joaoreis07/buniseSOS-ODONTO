  @@index([appointmentId])
  @@index([treatmentPlanItemId])
  @@index([professionalId])
}

model ClinicalEvolutionTooth {
  id          String        @id @default(cuid())
  evolutionId String
  toothNumber Int
  surfaces    ToothSurface[] @default([])

