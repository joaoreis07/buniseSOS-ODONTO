generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Plan {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  DEBUG
}

enum FeatureKey {
  agenda
  patients
  odontogram
  treatments
  finance
  budgets
  documents
  clinical_records
  reports
  inventory
  admin
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  isPlatformAdmin Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts            Account[]
  sessions            Session[]
  memberships         Membership[]
  auditLogs           AuditLog[]
  systemLogs          SystemLog[]
  notifications       Notification[]
  patientsCreated     Patient[]             @relation("PatientCreatedBy")
  patientsUpdated     Patient[]             @relation("PatientUpdatedBy")
  odontogramsCreated  Odontogram[]          @relation("OdontogramCreatedBy")
  odontogramsUpdated  Odontogram[]          @relation("OdontogramUpdatedBy")
  conditionsCreated   ToothCondition[]      @relation("ConditionCreatedBy")
  conditionsUpdated   ToothCondition[]      @relation("ConditionUpdatedBy")
  proceduresCreated   OdontogramProcedure[] @relation("ProcedureCreatedBy")
  proceduresUpdated   OdontogramProcedure[] @relation("ProcedureUpdatedBy")
  observationsCreated ToothObservation[]    @relation("ObservationCreatedBy")
  observationsUpdated ToothObservation[]    @relation("ObservationUpdatedBy")
  odontogramEvents    OdontogramEvent[]     @relation("OdontogramEventActor")
  budgetsCreated      TreatmentBudget[]     @relation("BudgetCreatedBy")
  budgetsUpdated      TreatmentBudget[]     @relation("BudgetUpdatedBy")
  budgetsApproved     TreatmentBudget[]     @relation("BudgetApprovedBy")
  budgetEvents        BudgetEvent[]         @relation("BudgetEventActor")
  treatmentPlansCreated TreatmentPlan[]     @relation("TreatmentPlanCreatedBy")
  treatmentPlansUpdated TreatmentPlan[]     @relation("TreatmentPlanUpdatedBy")
  treatmentPlanEvents   TreatmentPlanEvent[]  @relation("TreatmentPlanEventActor")
  receivablesCreated  Receivable[]          @relation("ReceivableCreatedBy")
  receivablesUpdated  Receivable[]          @relation("ReceivableUpdatedBy")
  paymentsRegistered  Payment[]             @relation("PaymentRegisteredBy")
  financeEvents       FinanceEvent[]        @relation("FinanceEventActor")
  anamnesesCreated    PatientAnamnesis[]    @relation("AnamnesisCreatedBy")
  anamnesesUpdated    PatientAnamnesis[]    @relation("AnamnesisUpdatedBy")
  anamnesisRevisions  AnamnesisRevision[]   @relation("AnamnesisRevisionActor")
  evolutionsCreated   ClinicalEvolution[]   @relation("EvolutionCreatedBy")
  evolutionsUpdated   ClinicalEvolution[]   @relation("EvolutionUpdatedBy")
  evolutionEvents     ClinicalEvolutionEvent[] @relation("EvolutionEventActor")
  attachmentsCreated  ClinicalAttachment[]  @relation("AttachmentCreatedBy")
  patientNotes        PatientNote[]         @relation("PatientNoteAuthor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id                   String             @id @default(cuid())
  name                 String
  logo                 String?
  cnpj                 String?
  phone                String?
  email                String?
  address              String?
  city                 String?
  state                String?
  zipCode              String?
  plan                 Plan               @default(STARTER)
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?

  memberships          Membership[]
  settings             CompanySettings?
  notifications        Notification[]
  auditLogs            AuditLog[]
  systemLogs           SystemLog[]
  featureFlags         FeatureFlag[]
  patients             Patient[]
  professionals        Professional[]
  rooms                Room[]
  chairs               Chair[]
  appointments         Appointment[]
  scheduleBlocks       ScheduleBlock[]
  waitingList          WaitingListEntry[]
  returnAlerts         ReturnAlert[]
  odontograms          Odontogram[]
  odontogramTeeth      OdontogramTooth[]
  toothConditions      ToothCondition[]
  odontogramProcedures OdontogramProcedure[]
  toothObservations    ToothObservation[]
  odontogramEvents     OdontogramEvent[]
  procedureCatalog     ProcedureCatalog[]
  priceTables          PriceTable[]
  budgets              TreatmentBudget[]
  budgetItems          TreatmentBudgetItem[]
  budgetEvents         BudgetEvent[]
  receivables          Receivable[]
  installments         Installment[]
  payments             Payment[]
  financeEvents        FinanceEvent[]
  treatmentPlans       TreatmentPlan[]
  treatmentPlanItems   TreatmentPlanItem[]
  treatmentPlanEvents  TreatmentPlanEvent[]
  patientAnamneses     PatientAnamnesis[]
  anamnesisRevisions   AnamnesisRevision[]
  clinicalEvolutions   ClinicalEvolution[]
  clinicalEvolutionEvents ClinicalEvolutionEvent[]
  clinicalAttachments  ClinicalAttachment[]
  patientNotes         PatientNote[]

  @@index([deletedAt])
  @@index([cnpj])
}

model Membership {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  role      Role      @default(EMPLOYEE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, deletedAt])
  @@index([userId, deletedAt])
}

model CompanySettings {
  id            String   @id @default(cuid())
  companyId     String   @unique
  theme         String   @default("light")
  language      String   @default("pt-BR")
  currency      String   @default("BRL")
  timezone      String   @default("America/Sao_Paulo")
  dateFormat    String   @default("dd/MM/yyyy")
  notifications Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String?
  title     String
  message   String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, deletedAt])
  @@index([companyId, userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  module    String
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([module, action])
}

model SystemLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  level     LogLevel @default(INFO)
  module    String
  message   String
  ip        String?
  browser   String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([level, createdAt])
  @@index([module, createdAt])
}

model FeatureFlag {
  id        String     @id @default(cuid())
  companyId String
  feature   FeatureKey
  enabled   Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, feature])
  @@index([companyId])
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PatientGender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
}

enum ScheduleBlockType {
  LUNCH
  UNAVAILABLE
  BLOCK
  HOLIDAY
}

enum WaitingListStatus {
  WAITING
  SCHEDULED
  CANCELED
  EXPIRED
}

enum OdontogramPhase {
  CURRENT
  PLANNED
}

enum OdontogramRecordStatus {
  ACTIVE
  IN_PROGRESS
  COMPLETED
  RESOLVED
  CANCELLED
}

enum ToothSurface {
  MESIAL
  DISTAL
  OCCLUSAL
  VESTIBULAR
  LINGUAL
  INCISAL
  CERVICAL
  WHOLE
}

enum OdontogramEventType {
  CONDITION_CREATED
  CONDITION_UPDATED
  CONDITION_REMOVED
  PROCEDURE_CREATED
  PROCEDURE_UPDATED
  PROCEDURE_REMOVED
  OBSERVATION_CREATED
  OBSERVATION_UPDATED
  OBSERVATION_REMOVED
}

enum BudgetStatus {
  DRAFT
  SENT
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  CANCELED
  COMPLETED
}

enum BudgetItemStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BudgetEventType {
  CREATED
  UPDATED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_REMOVED
  SENT
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  CANCELED
  COMPLETED
}

enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  PIX
  CASH
  CARD_CREDIT
  CARD_DEBIT
  BOLETO
  TRANSFER
  OTHER
}

enum FinanceEventType {
  RECEIVABLE_CREATED
  INSTALLMENTS_CREATED
  PAYMENT_REGISTERED
  INSTALLMENT_CANCELLED
  RECEIVABLE_CANCELLED
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TreatmentPlanItemStatus {
  PLANNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentPlanEventType {
  CREATED
  UPDATED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_REMOVED
  ITEM_STATUS_CHANGED
  BUDGET_CREATED
  COMPLETED
  CANCELLED
  DELETED
}

model Patient {
  id               String         @id @default(cuid())
  companyId        String
  /// Nome completo — campo `name` preservado para Agenda
  name             String
  preferredName    String?
  birthDate        DateTime?
  gender           PatientGender  @default(UNSPECIFIED)
  cpf              String?
  document         String?
  rg               String?
  email            String?
  phone            String?
  whatsapp         String?
  maritalStatus    MaritalStatus?
  profession       String?
  address          String?
  addressNumber    String?
  district         String?
  city             String?
  state            String?
  zipCode          String?
  responsibleName  String?
  responsiblePhone String?
  insurance        String?
  insuranceNumber  String?
  bloodType        BloodType      @default(UNKNOWN)
  allergies        String?        @db.Text
  medicalNotes     String?        @db.Text
  observations     String?        @db.Text
  notes            String?        @db.Text
  photoUrl         String?
  isActive         Boolean        @default(true)
  status           PatientStatus  @default(ACTIVE)
  createdById      String?
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?              @relation("PatientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  appointments Appointment[]
  waitingList  WaitingListEntry[]
  returnAlerts ReturnAlert[]
  odontogram   Odontogram?
  budgets       TreatmentBudget[]
  treatmentPlans TreatmentPlan[]
  anamnesis      PatientAnamnesis?
  clinicalEvolutions ClinicalEvolution[]
  clinicalAttachments ClinicalAttachment[]
  patientNotes        PatientNote[]
  receivables   Receivable[]
  installments  Installment[]
  payments      Payment[]

  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@index([companyId, cpf])
  @@index([companyId, phone])
  @@index([companyId, isActive])
  @@index([companyId, document])
  @@index([companyId, status])
  @@index([createdById])
  @@index([updatedById])
}

model Professional {
  id        String    @id @default(cuid())
  companyId String
  name      String
  color     String    @default("#0b3d91")
  email     String?
  phone     String?
  specialty String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments         Appointment[]
  scheduleBlocks       ScheduleBlock[]
  waitingList          WaitingListEntry[]
  toothConditions      ToothCondition[]
  odontogramProcedures OdontogramProcedure[]
  budgetItems          TreatmentBudgetItem[]
  receivableItems      ReceivableItem[]
  treatmentPlans       TreatmentPlan[]       @relation("TreatmentPlanResponsible")
  treatmentPlanItems   TreatmentPlanItem[]
  clinicalEvolutions   ClinicalEvolution[]
  clinicalAttachments  ClinicalAttachment[]

  @@index([companyId, deletedAt])
  @@index([companyId, active])
}

model Room {
  id        String    @id @default(cuid())
  companyId String
  name      String
  color     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chairs         Chair[]
  appointments   Appointment[]
  scheduleBlocks ScheduleBlock[]

  @@index([companyId, deletedAt])
}

model Chair {
  id        String    @id @default(cuid())
  companyId String
  roomId    String?
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([companyId, deletedAt])
  @@index([roomId])
}

model Appointment {
  id                String            @id @default(cuid())
  companyId         String
  patientId         String
  professionalId    String
  roomId            String?
  chairId           String?
  status            AppointmentStatus @default(SCHEDULED)
  title             String?
  procedure         String?
  notes             String?           @db.Text
  startsAt          DateTime
  endsAt            DateTime
  confirmedAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  canceledAt        DateTime?
  cancelReason      String?
  recurrenceRule    String?
  recurrenceGroupId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient              Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional         Professional          @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  room                 Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  chair                Chair?                @relation(fields: [chairId], references: [id], onDelete: SetNull)
  toothConditions      ToothCondition[]
  odontogramProcedures OdontogramProcedure[]
  treatmentPlanItems   TreatmentPlanItem[]
  clinicalEvolutions   ClinicalEvolution[]

  @@index([companyId, deletedAt])
  @@index([companyId, startsAt, endsAt])
  @@index([companyId, professionalId, startsAt])
  @@index([companyId, status, deletedAt])
  @@index([patientId])
  @@index([recurrenceGroupId])
}

model ScheduleBlock {
  id             String            @id @default(cuid())
  companyId      String
  professionalId String?
  roomId         String?
  type           ScheduleBlockType @default(BLOCK)
  title          String?
  startsAt       DateTime
  endsAt         DateTime
  allDay         Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([companyId, deletedAt])
  @@index([companyId, startsAt, endsAt])
  @@index([professionalId])
}

model WaitingListEntry {
  id             String            @id @default(cuid())
  companyId      String
  patientId      String
  professionalId String?
  preferredDate  DateTime?
  notes          String?           @db.Text
  status         WaitingListStatus @default(WAITING)
  priority       Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([companyId, deletedAt, status])
  @@index([patientId])
}

model ReturnAlert {
  id          String    @id @default(cuid())
  companyId   String
  patientId   String
  dueDate     DateTime
  reason      String?
  notes       String?   @db.Text
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([companyId, deletedAt, dueDate])
  @@index([patientId])
}

model Odontogram {
  id          String    @id @default(cuid())
  companyId   String
  patientId   String    @unique
  notation    String    @default("FDI")
  version     Int       @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient      Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy    User?                 @relation("OdontogramCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                 @relation("OdontogramUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  teeth        OdontogramTooth[]
  conditions   ToothCondition[]
  procedures   OdontogramProcedure[]
  observations ToothObservation[]
  events       OdontogramEvent[]

  @@index([companyId, deletedAt])
  @@index([companyId, patientId])
}

model OdontogramTooth {
  id           String   @id @default(cuid())
  companyId    String
  odontogramId String
  toothNumber  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  odontogram   Odontogram            @relation(fields: [odontogramId], references: [id], onDelete: Cascade)
  conditions   ToothCondition[]
  procedures   OdontogramProcedure[]
  observations ToothObservation[]
  events       OdontogramEvent[]

  @@unique([odontogramId, toothNumber])
  @@index([companyId, odontogramId])
  @@index([companyId, toothNumber])
}

model ToothCondition {
  id             String                 @id @default(cuid())
  companyId      String
  odontogramId   String
  toothId        String
  code           String
  title          String
  phase          OdontogramPhase        @default(CURRENT)
  status         OdontogramRecordStatus @default(ACTIVE)
  notes          String?                @db.Text
  professionalId String?
  appointmentId  String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?

  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  odontogram   Odontogram              @relation(fields: [odontogramId], references: [id], onDelete: Cascade)
  tooth        OdontogramTooth         @relation(fields: [toothId], references: [id], onDelete: Cascade)
  professional Professional?           @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  appointment  Appointment?            @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy    User?                   @relation("ConditionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                   @relation("ConditionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  surfaces     ToothConditionSurface[]
  procedures   OdontogramProcedure[]

  @@index([companyId, odontogramId, phase, status])
  @@index([toothId, deletedAt])
  @@index([appointmentId])
}

model ToothConditionSurface {
  id          String       @id @default(cuid())
  conditionId String
  surface     ToothSurface

  condition ToothCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@unique([conditionId, surface])
}

model OdontogramProcedure {
  id             String                 @id @default(cuid())
  companyId      String
  odontogramId   String
  toothId        String
  conditionId    String?
  code           String
  title          String
  phase          OdontogramPhase        @default(PLANNED)
  status         OdontogramRecordStatus @default(ACTIVE)
  surfaces       ToothSurface[]
  notes          String?                @db.Text
  professionalId String?
  appointmentId  String?
  plannedAt      DateTime?
  completedAt    DateTime?
  createdById    String?
  updatedById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  odontogram   Odontogram            @relation(fields: [odontogramId], references: [id], onDelete: Cascade)
  tooth        OdontogramTooth       @relation(fields: [toothId], references: [id], onDelete: Cascade)
  condition    ToothCondition?       @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  professional Professional?         @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  appointment  Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy    User?                 @relation("ProcedureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                 @relation("ProcedureUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  budgetItems  TreatmentBudgetItem[]
  treatmentPlanItems TreatmentPlanItem[]

  @@index([companyId, odontogramId, phase, status])
  @@index([toothId, deletedAt])
  @@index([conditionId])
  @@index([appointmentId])
}

model ToothObservation {
  id           String    @id @default(cuid())
  companyId    String
  odontogramId String
  toothId      String
  body         String    @db.Text
  createdById  String?
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  odontogram Odontogram      @relation(fields: [odontogramId], references: [id], onDelete: Cascade)
  tooth      OdontogramTooth @relation(fields: [toothId], references: [id], onDelete: Cascade)
  createdBy  User?           @relation("ObservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
