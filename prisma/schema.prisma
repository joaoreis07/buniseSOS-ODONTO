  budgetItem TreatmentBudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)

  @@unique([budgetItemId, toothNumber])
  @@index([toothNumber])
}

model BudgetEvent {
  id        String          @id @default(cuid())
  companyId String
  budgetId  String
  actorId   String?
