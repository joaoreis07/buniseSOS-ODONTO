  @@unique([evolutionId, toothNumber])
  @@index([toothNumber])
}

model ClinicalEvolutionEvent {
  id          String                     @id @default(cuid())
  companyId   String
  evolutionId String
  actorId     String?
  type        ClinicalEvolutionEventType
  before      Json?
  after       Json?
  createdAt   DateTime                   @default(now())

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  evolution ClinicalEvolution @relation(fields: [evolutionId], references: [id], onDelete: Cascade)
  actor     User?             @relation("EvolutionEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, evolutionId, createdAt])
}

model ClinicalAttachment {
  id             String                 @id @default(cuid())
  companyId      String
  patientId      String
  evolutionId    String?
  professionalId String?
  type           ClinicalAttachmentType @default(DOCUMENT)
  title          String
  description    String?                @db.Text
  category       String                 @default("document")
  fileKey        String?
  fileName       String?
  contentType    String?
  fileSize       Int?
  occurredAt     DateTime?
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
