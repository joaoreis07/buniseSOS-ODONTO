model ProcedureCatalog {
  id           String    @id @default(cuid())
  companyId    String
  code         String
  name         String
  description  String?   @db.Text
  category     String?
  defaultPrice Decimal   @default(0) @db.Decimal(12, 2)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceTableItems PriceTableItem[]
  budgetItems     TreatmentBudgetItem[]
  treatmentPlanItems TreatmentPlanItem[]
  clinicalEvolutions ClinicalEvolution[]

  @@unique([companyId, code])
  @@index([companyId, active, deletedAt])
  @@index([companyId, category])
}

model PriceTable {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?   @db.Text
  active      Boolean   @default(true)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   PriceTableItem[]
  budgets TreatmentBudget[]

  @@unique([companyId, name])
  @@index([companyId, active, deletedAt])
}

model PriceTableItem {
  id           String   @id @default(cuid())
  companyId    String
  priceTableId String
  procedureId  String
  unitPrice    Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  priceTable PriceTable       @relation(fields: [priceTableId], references: [id], onDelete: Cascade)
  procedure  ProcedureCatalog @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([priceTableId, procedureId])
  @@index([companyId, priceTableId])
  @@index([companyId, procedureId])
}

model TreatmentBudget {
  id              String       @id @default(cuid())
  companyId       String
  patientId       String
  treatmentPlanId String?
  priceTableId    String?
  createdById     String?
  updatedById     String?
  code            String
  title           String
  notes           String?      @db.Text
  status          BudgetStatus @default(DRAFT)
  subtotal     Decimal      @default(0) @db.Decimal(12, 2)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  total        Decimal      @default(0) @db.Decimal(12, 2)
  sentAt       DateTime?
  approvedAt   DateTime?
  approvedById String?
  completedAt  DateTime?
  canceledAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient       Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatmentPlan TreatmentPlan?        @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)
  priceTable    PriceTable?           @relation(fields: [priceTableId], references: [id], onDelete: SetNull)
  createdBy     User?                 @relation("BudgetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                 @relation("BudgetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedBy    User?                 @relation("BudgetApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items         TreatmentBudgetItem[]
  events        BudgetEvent[]
  receivable    Receivable?

  @@unique([companyId, code])
  @@index([companyId, patientId, deletedAt])
  @@index([companyId, status, deletedAt])
  @@index([priceTableId])
  @@index([treatmentPlanId])
}

model TreatmentBudgetItem {
  id                    String           @id @default(cuid())
  companyId             String
  budgetId              String
  procedureId           String?
  odontogramProcedureId String?
  treatmentPlanItemId   String?                  @unique
  professionalId        String?
  code                  String?
  description           String
  quantity              Decimal          @default(1) @db.Decimal(10, 2)
  unitPrice             Decimal          @default(0) @db.Decimal(12, 2)
